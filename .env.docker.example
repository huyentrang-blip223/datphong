# Copy this file to .env.docker. Never commit .env.docker.
APP_NAME="DT07 Homestay"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
HTTP_PORT=8080

MYSQL_DATABASE=dt07_homestay
MYSQL_USER=dt07_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
DEPLOY_DEMO_DATA=false

PY_SERVICE_TOKEN=replace-with-a-long-random-token
SESSION_SECURE_COOKIE=false
TRUSTED_PROXIES=

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=

VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_SECRET_KEY=
VNPAY_RETURN_URL=
